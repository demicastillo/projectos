# URL pública definitiva del sitio (sin barra final). Se usa en canonical, sitemap y Open Graph.
# Mientras no haya dominio, dejarla vacía: el sitemap no se publica con un dominio de ejemplo.
NEXT_PUBLIC_SITE_URL=

# Envío de consultas. Valores posibles:
#   (vacío)  -> el formulario responde que el envío no está disponible y ofrece WhatsApp. Nunca simula éxito.
#   demo     -> solo para desarrollo local: valida y responde "modo demostración"; no guarda ni envía nada.
#   resend   -> envía la notificación a la academia y el acuse a la persona con Resend (requiere las variables de abajo).
CONTACT_MODE=

# Resend (https://resend.com). Remitente de un dominio verificado en Resend; nunca el correo del visitante.
RESEND_API_KEY=
CONTACT_FROM="StartEs <consultas@tu-dominio-verificado>"
# Destino de las notificaciones de la academia.
CONTACT_TO=masgoret555@gmail.com
